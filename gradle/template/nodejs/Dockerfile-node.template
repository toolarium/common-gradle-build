FROM @@dockerImage@@

# define build settings
ARG EXPOSE_PORT="@@dockerExposePort@@"
ARG RUNTIMEUSER="@@dockerUser@@"
ARG TIMEZONE="@@dockerTimezone@@"
ARG DEPLOYMENT_SOURCE_PATH="@@dockerDeploymentSourcePath@@"
ARG DEPLOYMENT_PATH=/deployment
ARG DEFAULT_ENCODING="@@dockerDefaultEncoding@@"
ARG DEFAULT_LOCALE="@@dockerDefaultLocale@@"
ARG DEFAULT_LANGUAGE="@@dockerDefaultLanguage@@"
ARG REMOVE_IMAGE_VERSION="@@dockerRemoveImageVersion@@"
ARG REMOVE_PACKAGE_VERSIONS="@@dockerRemovePackageVersions@@"
ARG MAKE_FILESYSTEM_READONLY="@@dockerMakeFilesystemReadonly@@"
ARG READONLY_FILESYSTEM_PATH="@@dockerReadonlyFilesystemPath@@"
ARG READONLY_FILESYSTEM_EXCLUDE_PATH="@@dockerReadonlyFilesystemExcludePath@@"
ARG REMOVE_PACKAGE_INSTALLATION_BINARIES="@@dockerRemovePackageInstallationBinaries@@"
ARG REMOVE_NON_ESSENTIAL_BINARIES="@@dockerRemoveNonEssentialBinaries@@"
ARG ADDITIONAL_PACKAGES="@@dockerAdditionalPackages@@"

# set meta data
LABEL vendor="@@LICENSE_ORGANISATION@@" \
    group-id="@@GROUP_ID@@" \
    component-id="@@COMPONENT_ID@@" \
    description="@@DESCRIPTION@@" \
    url="@@URL@@" \
    license="@@LICENSE@@" \
    version="@@VERSION@@" \
    is-release-version="@@IS_RELEASE_VERSION@@" \
    build-timestamp="@@BUILD_TIMESTAMP_SHORT@@"

# set user
RUN adduser -D ${RUNTIMEUSER}

# update, set timezone and harden
RUN apk --no-cache -U upgrade \
    && apk --no-cache add tzdata \
    && if [ -n "${ADDITIONAL_PACKAGES}" ]; then apk --no-cache add ${ADDITIONAL_PACKAGES}; fi \
    && cp "/usr/share/zoneinfo/${TIMEZONE}" /etc/localtime \
    && echo "${TIMEZONE}" > /etc/timezone \
    # remove setuid/setgid binaries
    && find / -perm /6000 -type f -exec chmod a-s {} + 2>/dev/null || true \
    # remove cron and periodic
    && rm -rf /etc/crontabs /etc/periodic /var/spool/cron \
    # remove unnecessary system accounts
    && sed -i '/^root/!{/^nobody/!{/^'${RUNTIMEUSER}'/!d}}' /etc/passwd /etc/shadow /etc/group \
    # remove docs, man pages, includes
    && rm -rf /usr/share/man /usr/share/doc /usr/include

# remove version information and apk to prevent package installation
RUN if [ "${REMOVE_PACKAGE_INSTALLATION_BINARIES}" = "true" ]; then \
    apk del apk-tools alpine-keys 2>/dev/null; \
    rm /var/log/apk.log; \
    rm -rf /sbin/apk /etc/apk /lib/apk /usr/share/apk /var/lib/apk; \
    fi

# remove image version information
RUN if [ "${REMOVE_IMAGE_VERSION}" = "true" ]; then \
    rm -f /etc/alpine-release /etc/os-release /etc/issue; \
    fi

# remove non-essential binaries (node/npm/npx in /usr/local/bin are not wiped and survive intact)
RUN if [ "${REMOVE_NON_ESSENTIAL_BINARIES}" = "true" ]; then \
    if ! command -v busybox >/dev/null 2>&1; then \
    echo "WARNING: REMOVE_NON_ESSENTIAL_BINARIES=true requires an Alpine-based image (busybox not found). Skipping." >&2; \
    else \
    cp "$(command -v busybox)" /tmp/busybox && \
    [ -e /usr/sbin/update-ca-certificates ] && /tmp/busybox cp /usr/sbin/update-ca-certificates /tmp/update-ca-certificates; \
    [ -e /usr/bin/c_rehash ] && /tmp/busybox cp /usr/bin/c_rehash /tmp/c_rehash; \
    [ -e /usr/bin/openssl ] && /tmp/busybox cp /usr/bin/openssl /tmp/openssl; \
    /tmp/busybox rm -f /bin/* /sbin/* /usr/bin/* /usr/sbin/* 2>/dev/null; \
    /tmp/busybox cp /tmp/busybox /bin/busybox && \
    for cmd in sh cat chmod date dirname basename pwd ls hostname env grep tr sed stat tail sleep uname ps kill rm echo printf awk free cp mv readlink run-parts ash chgrp chown mkdir; do /bin/busybox ln -s busybox /bin/$cmd 2>/dev/null; done && \
    [ -e /tmp/update-ca-certificates ] && /bin/cp /tmp/update-ca-certificates /usr/sbin/update-ca-certificates && /bin/chmod 755 /usr/sbin/update-ca-certificates; \
    [ -e /tmp/c_rehash ] && /bin/cp /tmp/c_rehash /usr/bin/c_rehash && /bin/chmod 755 /usr/bin/c_rehash; \
    [ -e /tmp/openssl ] && /bin/cp /tmp/openssl /usr/bin/openssl && /bin/chmod 755 /usr/bin/openssl; \
    /bin/rm -rf /etc/apk /lib/apk /usr/share/apk /var/lib/apk /var/log/apk.log 2>/dev/null; \
    /bin/rm -f /tmp/busybox /tmp/update-ca-certificates /tmp/c_rehash /tmp/openssl 2>/dev/null; \
    fi; \
    fi

# create path
RUN mkdir -p ${DEPLOYMENT_PATH} \
    && chown -R ${RUNTIMEUSER} ${DEPLOYMENT_PATH} \
    && chmod -R 755 ${DEPLOYMENT_PATH} \
    && chmod -R g=u ${DEPLOYMENT_PATH}

# copy application
COPY --chown=${RUNTIMEUSER} ${DEPLOYMENT_SOURCE_PATH} ${DEPLOYMENT_PATH}/

# set language
ENV LANG="${DEFAULT_LOCALE}.${DEFAULT_ENCODING}" LANGUAGE="${DEFAULT_LOCALE}:${DEFAULT_LANGUAGE}"

# remove package version information (package.json, lock files that reveal dependency versions)
RUN if [ "${REMOVE_PACKAGE_VERSIONS}" = "true" ]; then \
    rm -f ${DEPLOYMENT_PATH}/package.json ${DEPLOYMENT_PATH}/package-lock.json ${DEPLOYMENT_PATH}/yarn.lock ${DEPLOYMENT_PATH}/.npmrc ${DEPLOYMENT_PATH}/.yarnrc 2>/dev/null || true; \
    fi

# make filesystem read-only friendly
RUN if [ "${MAKE_FILESYSTEM_READONLY}" = "true" ] && [ -n "${READONLY_FILESYSTEM_PATH}" ]; then \
    chmod a-w ${READONLY_FILESYSTEM_PATH}; \
    for p in ${READONLY_FILESYSTEM_EXCLUDE_PATH}; do \
        if [ -e "$p" ]; then chmod u+w "$p"; fi; \
    done; \
    fi

# set port
ENV EXPOSE_PORT="${EXPOSE_PORT}"

# expose port
EXPOSE ${EXPOSE_PORT}

# switch RUNTIMEUSER
USER ${RUNTIMEUSER}

# change working path
WORKDIR ${DEPLOYMENT_PATH}

# set nuxt host (port is set dynamically at startup from EXPOSE_PORT)
ENV NUXT_HOST=0.0.0.0

# start service
ENTRYPOINT @@dockerEntrypoint@@
